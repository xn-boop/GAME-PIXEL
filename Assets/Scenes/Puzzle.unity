  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 100000138}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 5f7201a12d95ffc409449d95f23cf332, type: 3}
  m_Name: 
  m_EditorClassIdentifier: UnityEngine.UI::UnityEngine.UI.Text
  m_Material: {fileID: 0}
  m_Color: {r: 0.95, g: 0.92, b: 0.86, a: 1.0}
  m_RaycastTarget: 0
  m_RaycastPadding: {x: 0, y: 0, z: 0, w: 0}
  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_FontData:
    m_Font: {fileID: 10102, guid: 0000000000000000e000000000000000, type: 0}
    m_FontSize: 16
    m_FontStyle: 0
    m_BestFit: 0
    m_MinSize: 10
    m_MaxSize: 40
    m_Alignment: 3
    m_AlignByGeometry: 0
    m_RichText: 1
    m_HorizontalOverflow: 0
    m_VerticalOverflow: 0
    m_LineSpacing: 1
  m_Text: "31/01/2014\n\nH\xF4m nay l\xE0 m\xF9ng M\u1ED9t T\u1EBFt. N\u0103m nay c\u1EA3 nh\xE0 t\xF4i quy\u1EBFt \u0111\u1ECBnh \u1EDF Vi\u1EC7t Nam \u0111\xF3n giao th\u1EEBa.\n\nNh\xE0 c\u1EEDa m\u1EA5y h\xF4m nay r\u1ED9n r\xE0ng h\u1EB3n l\xEAn, hoa mai n\u1EDF v\xE0ng tr\u01B0\u1EDBc s\xE2n, trong b\u1EBFp th\u01A1m m\xF9i b\xE1nh t\xE9t v\xE0 th\u1ECBt kho. \u0110\xEAm qua c\u1EA3 nh\xE0 c\xF9ng xem ph\xE1o hoa, ch\xFAc nhau n\u0103m m\u1EDBi b\xECnh an.\n\nS\xE1ng nay H\u1EA1 \xC2n \u0111\u01B0\u1EE3c m\u1EB7c qu\u1EA7n \xE1o m\u1EDBi, theo b\u1ED1 m\u1EB9 \u0111i ch\xFAc T\u1EBFt \xF4ng b\xE0 v\xE0 nh\u1EADn nh\u1EEFng bao l\xEC x\xEC \u0111\u1ECF. Nh\xECn con b\xE9 vui v\u1EBB ch\u1EA1y quanh nh\xE0, t\xF4i ch\u1EE3t th\u1EA5y T\u1EBFt ch\u1EA3ng c\u1EA7n g\xEC c\u1EA7u k\u1EF3, ch\u1EC9 c\u1EA7n c\u1EA3 nh\xE0 \u0111\u01B0\u1EE3c sum v\u1EA7y b\xEAn nhau l\xE0 \u0111\u1EE7."
